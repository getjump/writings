---
import Layout from "../components/Layout.astro";
import Heading from "../components/Heading.astro";
import Prose from "../components/Prose.astro";
import StructuredData from "../components/StructuredData.astro";
import { availability, person, personId, profile } from "../lib/profile";
import { postPath, sortByDate } from "../lib/posts";
import { getCollection } from "astro:content";

const posts = sortByDate(await getCollection("posts"));
---

<Layout
  title="About Pavel Savinov - Go Backend Engineer"
  description={profile.basics.summary}
>
  <StructuredData slot="head" nodes={[person, {
    "@type": "AboutPage",
    "@id": new URL(Astro.url.pathname, Astro.site).href,
    mainEntity: { "@id": personId },
  }]} />
  <section class="about">
    <Heading as="h1">About</Heading>
    <Prose>
      <p>
        I'm {profile.basics.name}, a senior backend engineer working in Go.
        {profile.basics.summary}
      </p>
      <p>{availability}</p>
      <p>
        <a href="/hire/">Experience, skills and contact details</a>.
        <a href="/cv.pdf">CV (PDF)</a>{" / "}<a href="/cv.json">CV (JSON)</a>.
      </p>

      <h2>Selected public work</h2>
      <ul>
        {profile.projects.map((project) => (
          <li><a href={project.url}>{project.name}</a> - {project.description}</li>
        ))}
      </ul>

      <h2>Writing</h2>
      <p>Distributed systems, testing and building software with AI agents.</p>
      <ul>
        {posts.map((post) => <li><a href={postPath(post)}>{post.data.title}</a></li>)}
      </ul>

      <h2>Contact</h2>
      <ul>
        {profile.basics.profiles.map((entry) => <li><a href={entry.url}>{entry.network}</a></li>)}
        <li><a href={`mailto:${profile.basics.email}`}>{profile.basics.email}</a></li>
      </ul>
    </Prose>
  </section>
</Layout>

<style>
  .about {
    max-width: var(--width-content);
  }

  .about > :global(.heading) {
    max-width: var(--measure);
    margin-left: auto;
    margin-right: auto;
  }
</style>
