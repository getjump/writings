---
import Layout from "../../components/Layout.astro";
import Article from "../../components/Article.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import F1Timeline from "../../components/F1Timeline.astro";
import StructuredData from "../../components/StructuredData.astro";
import PostFooter from "../../components/PostFooter.astro";
import { person, personId } from "../../lib/profile";
import { ogImageFor, readingMinutes, sortByDate } from "../../lib/posts";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = sortByDate(await getCollection("posts"));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, others: posts.filter((other) => other.id !== post.id) },
  }));
}

const { post, others } = Astro.props;
const { Content, headings } = await render(post);

const hasF1Phases = post.body?.includes("data-phase") ?? false;

const postUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = ogImageFor(post);
const modified = post.data.updated ?? post.data.date;
const minutes = readingMinutes(post);

const jsonLd = {
  "@type": "BlogPosting",
  "@id": `${postUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: modified.toISOString(),
  inLanguage: "en",
  url: postUrl,
  author: { "@id": personId },
  publisher: { "@id": personId },
  image: new URL(ogImage, Astro.site).href,
  isPartOf: { "@id": new URL("/#blog", Astro.site).href },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
};
---

<Layout
  title={post.data.seoTitle ?? post.data.title}
  socialTitle={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={ogImage}
  publishedTime={post.data.date}
  modifiedTime={post.data.updated}
>
  <StructuredData slot="head" nodes={[person, jsonLd]} />
  <TableOfContents headings={headings} />
  {hasF1Phases && <F1Timeline />}
  <Article
    title={post.data.title}
    date={post.data.date}
    updated={post.data.updated}
    description={post.data.description}
    minutes={minutes}
  >
    <Content />
  </Article>
  <PostFooter others={others.slice(0, 3)} />
</Layout>
