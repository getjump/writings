---
import Layout from "../../components/Layout.astro";
import Article from "../../components/Article.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import F1Timeline from "../../components/F1Timeline.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content, headings } = await render(post);

// Check if post body contains F1 phase markers
const hasF1Phases = post.body?.includes("data-phase") ?? false;

const postUrl = new URL(`/posts/${post.id}`, Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.date.toISOString(),
  "url": postUrl,
  "author": { "@type": "Person", "name": "Pavel Savinov", "url": "https://getjump.me/about" },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": postUrl,
  },
};
---

<Layout title={`${post.data.title}`} description={post.data.description} ogType="article" ogImage={post.data.ogImage}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <TableOfContents headings={headings} />
  {hasF1Phases && <F1Timeline />}
  <Article title={post.data.title} date={post.data.date} description={post.data.description}>
    <Content />
  </Article>
</Layout>
