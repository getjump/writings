---
const phases = [
  { label: "Phase 11\nBaseline", f1: 0.725 },
  { label: "+IRT\n(Phase 12)", f1: 0.754 },
  { label: "+Relabel\n(Phase 13)", f1: 0.771 },
  { label: "+ClassWeight\n(Phase 16)", f1: 0.778 },
  { label: "+HP Tuning\n(Phase 17)", f1: 0.780 },
  { label: "Per-game\nvote (21)", f1: 0.871 },
];

const baseline = 0.725;
const yMin = 0.700;
const yMax = 0.900;

const svgW = 700;
const svgH = 360;
const marginTop = 40;
const marginBottom = 60;
const marginLeft = 55;
const marginRight = 54;
const plotW = svgW - marginLeft - marginRight;
const plotH = svgH - marginTop - marginBottom;

const yTicks = [0.700, 0.725, 0.750, 0.775, 0.800, 0.825, 0.850, 0.875, 0.900];

function yScale(val: number) {
  return marginTop + plotH - ((val - yMin) / (yMax - yMin)) * plotH;
}

const groupW = plotW / phases.length;
const points = phases.map((p, i) => ({
  ...p,
  x: marginLeft + (i + 0.5) * groupW,
  y: yScale(p.f1),
  delta: i === 0 ? 0 : p.f1 - phases[i - 1].f1,
  isLast: i === phases.length - 1,
  labelBelow: (phases[i + 1]?.f1 ?? 0) - p.f1 > 0.05,
}));

const reportLine = points.slice(0, -1).map((p) => `${p.x},${p.y}`).join(" ");
const [beforeVote, vote] = points.slice(-2);

const baselineY = yScale(baseline);
const yBottom = yScale(yMin);

const summary = phases
  .map((p) => `${p.label.replace("\n", " ")}: ${p.f1.toFixed(3)}`)
  .join("; ");
---

<div class="cumulative-progress-wrapper">
  <svg
    viewBox={`0 0 ${svgW} ${svgH}`}
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={`Cumulative ML pipeline progress, F1 by phase. ${summary}.`}
    style="width:100%;height:auto;display:block;"
  >
    <text
      x={svgW / 2}
      y="24"
      text-anchor="middle"
      class="chart-title"
    >Cumulative ML Pipeline Progress</text>

    {yTicks.map((t) => {
      const y = yScale(t);
      return (
        <g>
          <line x1={marginLeft} y1={y} x2={marginLeft + plotW} y2={y} class="grid-line" />
          <text x={marginLeft - 8} y={y + 4} text-anchor="end" class="y-tick-label">
            {t.toFixed(3)}
          </text>
        </g>
      );
    })}

    <line
      x1={marginLeft}
      y1={baselineY}
      x2={marginLeft + plotW}
      y2={baselineY}
      class="baseline-line"
    />
    <text
      x={marginLeft + plotW + 4}
      y={baselineY - 15}
      class="baseline-label"
    ><tspan>Original</tspan><tspan x={marginLeft + plotW + 4} dy="11">baseline</tspan></text>

    <polyline points={reportLine} class="progress-line" />
    <line x1={beforeVote.x} y1={beforeVote.y} x2={vote.x} y2={vote.y} class="progress-line progress-line--vote" />

    {points.map((p, i) => (
      <g>
        <circle cx={p.x} cy={p.y} r={p.isLast ? 6 : 5} class:list={["point", { "point--vote": p.isLast }]} />
        <text x={p.x} y={p.labelBelow ? p.y + 22 : p.y - 12} text-anchor="middle" class="f1-label">{p.f1.toFixed(3)}</text>
        {i > 0 && (
          <text x={p.x} y={p.labelBelow ? p.y + 34 : p.y - 26} text-anchor="middle" class="delta-label">+{p.delta.toFixed(3)}</text>
        )}
        <text x={p.x} y={yBottom + 16} text-anchor="middle" class="x-label">
          {p.label.split("\n").map((line, li) => (
            <tspan x={p.x} dy={li === 0 ? 0 : 14}>{line}</tspan>
          ))}
        </text>
      </g>
    ))}
  </svg>
</div>

<style>
  .cumulative-progress-wrapper {
    position: relative;
    max-width: 100%;
    margin: 1.5rem auto;
    border: 1px solid var(--color-border, #e5e5e3);
    border-radius: 8px;
    padding: 1rem;
    background: var(--color-surface, #fff);
  }

  .chart-title {
    font-family: var(--font-heading, sans-serif);
    font-size: 16px;
    font-weight: 600;
    fill: var(--color-text, #1a1a1a);
  }

  .grid-line {
    stroke: var(--color-border, #e5e5e3);
    stroke-width: 0.5;
  }

  .y-tick-label {
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    fill: var(--color-text-secondary, #555);
  }

  .baseline-line {
    stroke: var(--chart-red);
    stroke-width: 1.5;
    stroke-dasharray: 6 4;
  }

  .baseline-label {
    font-family: var(--font-heading, sans-serif);
    font-size: 10px;
    fill: var(--chart-red);
  }

  .progress-line {
    fill: none;
    stroke: var(--chart-gray);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .progress-line--vote {
    stroke: var(--chart-green);
    stroke-dasharray: 5 4;
  }

  .point {
    fill: var(--chart-gray);
    stroke: var(--color-surface, #fff);
    stroke-width: 2;
  }

  .point--vote {
    fill: var(--chart-green);
  }

  .f1-label {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    font-weight: 600;
    fill: var(--color-text, #1a1a1a);
  }

  .delta-label {
    font-family: var(--font-mono, monospace);
    font-size: 9px;
    fill: var(--color-text-tertiary, #888);
  }

  .x-label {
    font-family: var(--font-heading, sans-serif);
    font-size: 10.5px;
    fill: var(--color-text-secondary, #555);
  }
</style>
