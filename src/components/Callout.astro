---
interface Props {
  type?: "info" | "warning" | "success" | "insight";
  title?: string;
}

const { type = "info", title } = Astro.props;
---

<aside class={`callout callout--${type}`} role="note">
  {title && <p class="callout__title">{title}</p>}
  <div class="callout__content">
    <slot />
  </div>
</aside>

<style>
  .callout {
    margin: 1.75em 0;
    padding: var(--space-md) var(--space-md);
    border-left: 3px solid var(--callout-accent);
    background-color: var(--callout-bg);
    border-radius: 0 4px 4px 0;
  }

  @media (min-width: 640px) {
    .callout {
      padding: var(--space-md) var(--space-lg);
    }
  }

  .callout--info {
    --callout-accent: #2f6496;
    --callout-bg: rgba(74, 127, 181, 0.06);
  }

  .callout--warning {
    --callout-accent: #80621a;
    --callout-bg: rgba(181, 148, 74, 0.06);
  }

  .callout--success {
    --callout-accent: #2b7347;
    --callout-bg: rgba(74, 158, 107, 0.06);
  }

  .callout--insight {
    --callout-accent: #6a4d96;
    --callout-bg: rgba(123, 94, 167, 0.06);
  }

  @media (prefers-color-scheme: dark) {
    .callout--info {
      --callout-accent: #7fb0e0;
    }

    .callout--warning {
      --callout-accent: #d4b46a;
    }

    .callout--success {
      --callout-accent: #6fc28f;
    }

    .callout--insight {
      --callout-accent: #ad93d6;
    }
  }

  .callout__title {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--callout-accent);
    margin-bottom: var(--space-xs);
  }

  .callout__content {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .callout__content :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
