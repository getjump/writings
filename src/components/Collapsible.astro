---
interface Props {
  title: string;
  open?: boolean;
}

const { title, open = false } = Astro.props;
---

<details class="collapsible" open={open || undefined}>
  <summary class="collapsible__summary">{title}</summary>
  <div class="collapsible__content">
    <slot />
  </div>
</details>

<style>
  .collapsible {
    margin: 1.75em 0;
    border-left: 2px solid var(--color-border);
    padding-left: var(--space-md);
    transition: border-color 0.2s ease;
  }

  .collapsible:hover {
    border-left-color: var(--color-text-tertiary);
  }

  .collapsible[open] {
    border-left-color: var(--color-text-secondary);
  }

  .collapsible__summary {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    padding: 0.375rem 0;
    cursor: pointer;
    user-select: none;
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    transition: color 0.15s ease;
  }

  .collapsible__summary::-webkit-details-marker {
    display: none;
  }

  .collapsible__summary::before {
    content: "";
    display: inline-block;
    width: 0.375em;
    height: 0.375em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.2s ease;
    flex-shrink: 0;
    opacity: 0.5;
  }

  .collapsible[open] > .collapsible__summary::before {
    transform: rotate(45deg);
  }

  .collapsible__summary:hover {
    color: var(--color-text-secondary);
  }

  .collapsible__content {
    padding: var(--space-sm) 0 var(--space-xs);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text);
    animation: collapsible-open 0.2s ease;
  }

  .collapsible__content :global(p:last-child) {
    margin-bottom: 0;
  }

  @keyframes collapsible-open {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
